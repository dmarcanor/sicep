digraph UC {
  rankdir=LR; splines=true; nodesep=0.3; ranksep=1.5;
  label=<<B>Administrador — Plantillas y documentos</B><BR/>SICEP-NNA (permisos predeterminados)>; labelloc=t; fontname="Helvetica"; fontsize=14;
  node [fontname="Helvetica", fontsize=10];
  edge [color="#1F3A5F", arrowhead=none];
  "A" [label="Administrador", shape=box, style="rounded,filled", fillcolor="#FFF2CC", fontname="Helvetica", fontsize=12];
  subgraph cluster_mod { label="Plantillas y documentos"; style="rounded"; color="#8EA9DB"; fontname="Helvetica"; fontsize=11;
    "UC40" [label="UC40  Gestionar plantillas", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
    "UC41" [label="UC41  Consultar plantillas", shape=ellipse, style=filled, fillcolor="#D9E2F3", fontsize=10];
    "UC42" [label="UC42  Crear borrador de documento", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
    "UC43" [label="UC43  Editar borrador de documento", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
    "UC44" [label="UC44  Emitir documento", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
    "UC45" [label="UC45  Descargar o imprimir documento", shape=ellipse, style=filled, fillcolor="#D9E2F3", fontsize=10];
    "UC46" [label="UC46  Descartar borrador", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
  }
  "PIN" [label="Confirmar con PIN", shape=ellipse, style=dashed, fontsize=10];
  "A" -> "UC40";
  "A" -> "UC41";
  "A" -> "UC42";
  "A" -> "UC43";
  "A" -> "UC44";
  "A" -> "UC45";
  "A" -> "UC46";
  "UC40" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
  "UC42" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
  "UC43" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
  "UC44" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
  "UC46" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
}