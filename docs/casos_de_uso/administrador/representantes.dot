digraph UC {
  rankdir=LR; splines=true; nodesep=0.3; ranksep=1.5;
  label=<<B>Administrador — Representantes</B><BR/>SICEP-NNA (permisos predeterminados)>; labelloc=t; fontname="Helvetica"; fontsize=14;
  node [fontname="Helvetica", fontsize=10];
  edge [color="#1F3A5F", arrowhead=none];
  "A" [label="Administrador", shape=box, style="rounded,filled", fillcolor="#FFF2CC", fontname="Helvetica", fontsize=12];
  subgraph cluster_mod { label="Representantes"; style="rounded"; color="#8EA9DB"; fontname="Helvetica"; fontsize=11;
    "UC13" [label="UC13  Registrar representante", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
    "UC14" [label="UC14  Editar representante", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
    "UC15" [label="UC15  Buscar representante por cédula", shape=ellipse, style=filled, fillcolor="#D9E2F3", fontsize=10];
  }
  "PIN" [label="Confirmar con PIN", shape=ellipse, style=dashed, fontsize=10];
  "A" -> "UC13";
  "A" -> "UC14";
  "A" -> "UC15";
  "UC13" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
  "UC14" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
}