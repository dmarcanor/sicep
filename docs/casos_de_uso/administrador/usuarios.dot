digraph UC {
  rankdir=LR; splines=true; nodesep=0.3; ranksep=1.5;
  label=<<B>Administrador — Usuarios</B><BR/>SICEP-NNA (permisos predeterminados)>; labelloc=t; fontname="Helvetica"; fontsize=14;
  node [fontname="Helvetica", fontsize=10];
  edge [color="#1F3A5F", arrowhead=none];
  "A" [label="Administrador", shape=box, style="rounded,filled", fillcolor="#FFF2CC", fontname="Helvetica", fontsize=12];
  subgraph cluster_mod { label="Usuarios"; style="rounded"; color="#8EA9DB"; fontname="Helvetica"; fontsize=11;
    "UC53" [label="UC53  Gestionar usuarios", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
    "UC54" [label="UC54  Cambiar contraseña de otro usuario", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
  }
  "PIN" [label="Confirmar con PIN", shape=ellipse, style=dashed, fontsize=10];
  "A" -> "UC53";
  "A" -> "UC54";
  "UC53" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
  "UC54" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
}