digraph UC {
  rankdir=LR; splines=true; nodesep=0.3; ranksep=1.5;
  label=<<B>Administrador — Configuración</B><BR/>SICEP-NNA (permisos predeterminados)>; labelloc=t; fontname="Helvetica"; fontsize=14;
  node [fontname="Helvetica", fontsize=10];
  edge [color="#1F3A5F", arrowhead=none];
  "A" [label="Administrador", shape=box, style="rounded,filled", fillcolor="#FFF2CC", fontname="Helvetica", fontsize=12];
  subgraph cluster_mod { label="Configuración"; style="rounded"; color="#8EA9DB"; fontname="Helvetica"; fontsize=11;
    "UC55" [label="UC55  Configurar permisos por rol", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
    "UC56" [label="UC56  Configurar parámetros del sistema", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
  }
  "PIN" [label="Confirmar con PIN", shape=ellipse, style=dashed, fontsize=10];
  "A" -> "UC55";
  "A" -> "UC56";
  "UC55" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
  "UC56" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
}