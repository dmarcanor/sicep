digraph UC {
  rankdir=LR; splines=true; nodesep=0.3; ranksep=1.5;
  label=<<B>Supervisor (secretaría) — NNA</B><BR/>SICEP-NNA (permisos predeterminados)>; labelloc=t; fontname="Helvetica"; fontsize=14;
  node [fontname="Helvetica", fontsize=10];
  edge [color="#1F3A5F", arrowhead=none];
  "S" [label="Supervisor (secretaría)", shape=box, style="rounded,filled", fillcolor="#FFF2CC", fontname="Helvetica", fontsize=12];
  subgraph cluster_mod { label="NNA"; style="rounded"; color="#8EA9DB"; fontname="Helvetica"; fontsize=11;
    "UC10" [label="UC10  Registrar NNA", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
    "UC11" [label="UC11  Editar NNA", shape=ellipse, style=filled, fillcolor="#E2EFD9", fontsize=10];
    "UC12" [label="UC12  Verificar NNA por documento", shape=ellipse, style=filled, fillcolor="#D9E2F3", fontsize=10];
  }
  "PIN" [label="Confirmar con PIN", shape=ellipse, style=dashed, fontsize=10];
  "S" -> "UC10";
  "S" -> "UC11";
  "S" -> "UC12";
  "UC10" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
  "UC11" -> "PIN" [style=dashed, arrowhead=open, label="<<include>>", fontsize=8];
}