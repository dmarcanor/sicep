digraph UC {
  rankdir=LR; splines=true; nodesep=0.3; ranksep=1.5;
  label=<<B>Supervisor (secretaría) — Historial</B><BR/>SICEP-NNA (permisos predeterminados)>; labelloc=t; fontname="Helvetica"; fontsize=14;
  node [fontname="Helvetica", fontsize=10];
  edge [color="#1F3A5F", arrowhead=none];
  "S" [label="Supervisor (secretaría)", shape=box, style="rounded,filled", fillcolor="#FFF2CC", fontname="Helvetica", fontsize=12];
  subgraph cluster_mod { label="Historial"; style="rounded"; color="#8EA9DB"; fontname="Helvetica"; fontsize=11;
    "UC50" [label="UC50  Consultar historial", shape=ellipse, style=filled, fillcolor="#D9E2F3", fontsize=10];
    "UC51" [label="UC51  Ver línea de tiempo de un registro", shape=ellipse, style=filled, fillcolor="#D9E2F3", fontsize=10];
    "UC52" [label="UC52  Exportar historial a CSV", shape=ellipse, style=filled, fillcolor="#D9E2F3", fontsize=10];
  }
  "S" -> "UC50";
  "S" -> "UC51";
  "S" -> "UC52";
}