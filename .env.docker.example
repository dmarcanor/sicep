# Copie este archivo como .env en la raíz del proyecto antes de levantar el
# stack. Docker Compose lo lee automáticamente.
#
#   cp .env.docker.example .env
#
# Y genere la clave de la aplicación (sin ella el contenedor no arranca).
# Es sencillamente base64 de 32 bytes aleatorios, así que no hace falta Docker
# ni PHP, y es instantáneo:
#
#   echo "base64:$(openssl rand -base64 32)"
#
# Pegue el valor resultante (incluido el prefijo base64:) en APP_KEY.
#
# La alternativa con artisan da el mismo resultado, pero obliga a construir
# antes toda la imagen de la API, cosa que tarda varios minutos en un servidor
# modesto:
#
#   docker compose run --rm --no-deps api php artisan key:generate --show

APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
LOG_LEVEL=warning

# Puerto por el que se entra al sistema desde el navegador.
WEB_PORT=8080

DB_DATABASE=sicep
DB_USERNAME=sicep
DB_PASSWORD=cambie-esta-clave
DB_ROOT_PASSWORD=cambie-esta-clave-tambien

# Puerto del host para conectarse a MariaDB con un cliente externo.
# Cámbielo si el 3306 ya está ocupado en la máquina.
DB_PORT_HOST=3306

# --- Sólo para producción (compose.prod.yaml) ---
# Dominio que apunta a la VPS. Caddy pide el certificado TLS para este nombre,
# así que el DNS debe resolver a la máquina ANTES de levantar el stack.
DOMINIO=sicep.midominio.gob.ve
# Correo al que Let's Encrypt avisa si un certificado va a caducar.
ACME_EMAIL=informatica@midominio.gob.ve
